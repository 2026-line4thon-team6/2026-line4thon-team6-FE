# 백엔드 API 주소. 비워 두면 목 데이터로 동작한다
# 예) https://api.example.com/api/v1
# 로컬에서 실서버에 붙을 때는 /api/v1 로 두고 아래 API_PROXY_TARGET 에 서버 주소를 넣는다
VITE_API_BASE_URL=

# 로컬 개발 서버 전용 프록시 대상. 백엔드 CORS가 localhost를 막아서 개발 서버가 대신 요청한다
# 예) https://15.164.137.250
API_PROXY_TARGET=

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔). 콘솔에 등록한 웹 도메인(localhost:5173 등)에서만 지도가 뜬다
VITE_KAKAO_MAP_KEY=
